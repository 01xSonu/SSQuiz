# SSQuiz Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Vercel Cron Secret ───────────────────────────────────────────────────────
# Generate any random string for securing the daily-reset cron endpoint
CRON_SECRET=your-random-secret-here

# ─── Optional: Admin Email ────────────────────────────────────────────────────
# Set this to your account email to restrict the /admin portal to yourself
ADMIN_EMAIL=your-admin-email@gmail.com
